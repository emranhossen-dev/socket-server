# Dependency directories (ভারী ফাইল যা গিটহাবে পুশ করা যাবে না)
node_modules/
jspm_packages/

# Environment variables (তোমার Supabase keys এবং গোপন সিক্রেট ফাইল)
.env
.env.local
.env.production
.env.development

# Debug logs (এরর লগ ফাইল)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System Files (ওএস জেনারেটেড ফাইল)
.DS_Store
Thumbs.db

# Production build outputs (যদি ভবিষ্যতে কোনো বিল্ড ফোল্ডার তৈরি হয়)
dist/
build/